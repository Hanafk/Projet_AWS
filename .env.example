# Copier ce fichier en ".env" puis remplacer les valeurs par tes propres clés.
# Ne jamais commiter le fichier .env (il est déjà dans .gitignore).

OPENAI_API_KEY=ta-cle-openai
GROQ_API_KEY=ta-cle-groq
GOOGLE_API_KEY=ta-cle-google
LLM_PROVIDER=groq

# Optionnel : traçage LangSmith (notebook/evaluations.ipynb)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=ta-cle-langsmith
LANGCHAIN_PROJECT=multidocchat
